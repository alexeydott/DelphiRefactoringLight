<?xml version="1.0" encoding="UTF-8"?>
<dih>
	<!-- Win32 = 32-bit IDE (bin/bds.exe), Win64 = 64-bit IDE (bin64/bds.exe).
	     Each gets its own build, its own BPL directory (Bpl vs Bpl/Win64)
	     and its own registry branch ("Known Packages" vs "... x64").
	     NO library search path entry for the package's own DCU folder: the
	     IDE loads the BPL, nobody compiles against these units - and with
	     the Release DCUs on the path DelphiLSP took the plugin's units from
	     them (no debug info) and answered nothing for them while working on
	     the plugin itself. -->
	<entry id="DelphiRefactoringLight" description="Delphi Refactoring Light - Rename / Find References / Extract Method via DelphiLSP">
		<paths>
			<browsing platforms="Win32,Win64">
				<entry recursive="False">Source</entry>
			</browsing>
		</paths>
		<build platforms="Win32,Win64">
			<project>Packages\DelphiRefactoringLight.dproj</project>
		</build>
		<!-- {#LibSuffix} matches {$LIBSUFFIX AUTO} in the .dpk ("370"), and
		     {#BplTargetDir} already resolves to Bpl or Bpl\Win64. Naming the
		     built file this way keeps "what was built" and "what gets
		     registered" identical on both platforms. -->
		<packages platforms="Win32,Win64">
			<package description="Delphi Refactoring Light (Design-Time)">{#BplTargetDir}\DelphiRefactoringLight{#LibSuffix}.bpl</package>
		</packages>
	</entry>

	<!-- The MCP bridge for Claude Code. It used to be built by a batch file
	     AFTER the installer had already printed its summary, which is how a
	     failure could sit between two success messages (1.15.2) - so it is
	     an entry of its own now and its result stands in the same table.
	     Win32 ONLY: one exe serves both IDEs, it talks to them over a named
	     pipe and is started by Claude Code, not by the IDE.
	     stage="after-build" is what makes the copy happen AFTER the compiler
	     ran; without it the installer would install the previous build. The
	     copy itself tolerates a RUNNING bridge: Windows refuses to overwrite
	     such a file but allows renaming it, so the old one is moved aside
	     under a unique name (1.22.1 - a fixed ".old" is held by the process
	     that was started from it).
	     The post event is the verification: the exe that is now installed
	     has to answer --version. A copy that reported success while the old
	     file stayed is exactly what cost nine days once. -->
	<entry id="RefactoringLightMcp" description="MCP bridge for Claude Code (RefactoringLightMcp.exe)">
		<build platforms="Win32">
			<project>Mcp\RefactoringLightMcp.dproj</project>
		</build>
		<files platforms="Win32" stage="after-build">
			<file target="{#LocalAppData}\DelphiRefactoringLight\mcp\RefactoringLightMcp.exe">Mcp\Bin\RefactoringLightMcp.exe</file>
		</files>
		<post platforms="Win32">
			<exec description="Checking the installed bridge answers">"{#LocalAppData}\DelphiRefactoringLight\mcp\RefactoringLightMcp.exe" --version</exec>
		</post>
	</entry>
</dih>
